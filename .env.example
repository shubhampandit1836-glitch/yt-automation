# Copy this file to .env in the repository root:
#   cp .env.example .env
# Never commit .env, OAuth files or provider tokens.

# ------------------- control plane -------------------
APP_ENV=development
DATABASE_PATH=./data/yt_automation.db
MEDIA_DIR=./data/media
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
ENABLE_SCHEDULER=false
# Keep true until you have tested a private YouTube upload end to end.
DRY_RUN=true
OWNER_EMAIL=owner@example.com

# ------------------- reasoning and research -------------------
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq console: https://console.groq.com/keys
# Used for optional Whisper word timestamps.
GROQ_API_KEY=

# Stock assets (optional): https://www.pexels.com/api/ and https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Edge TTS fallback; no key, but it is an unofficial provider.
TTS_VOICE=hi-IN-SwaraNeural

# Comma-separated RSS feeds used by the grounded research adapter.
RSS_URLS=https://news.google.com/rss/search?q=gaming&hl=en-IN&gl=IN&ceid=IN:en,https://www.pcgamer.com/rss/,https://www.eurogamer.net/feed

# ------------------- YouTube OAuth -------------------
# Download an OAuth Desktop/Web client JSON from Google Cloud Console and
# save it at secrets/youtube-client.json. The app creates the token file after
# you authorize the channel in the browser.
YOUTUBE_CLIENT_SECRET_FILE=secrets/youtube-client.json
YOUTUBE_TOKEN_FILE=secrets/youtube-token.json
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/auth/youtube/callback
# Optional: set this after OAuth if the account owns more than one channel.
YOUTUBE_CHANNEL_ID=

# ------------------- optional notifications -------------------
# Telegram: message @BotFather, create a bot, then get the chat id from
# https://api.telegram.org/bot<BOT_TOKEN>/getUpdates after messaging the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Healthchecks.io: create a check at https://healthchecks.io/ and copy its ping URL.
HEALTHCHECKS_HEARTBEAT_URL=

# ------------------- frontend -------------------
# Leave this commented for local development; Vite proxies /api to port 8000.
# VITE_API_BASE_URL=/api/v1

# ------------------- comments and memory -------------------
COMMENT_REPLIES_ENABLED=false
COMMENT_MAX_REPLIES=3
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
