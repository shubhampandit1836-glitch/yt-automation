# Copy this file to .env in the repository root:
#   cp .env.example .env
# Never commit .env or paste secret values into chat.

# ------------------- control plane -------------------
APP_ENV=development
DATABASE_PATH=./data/yt_automation.db
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
ENABLE_SCHEDULER=false
# Keep this true until real research, render and YouTube adapters are installed.
DRY_RUN=true
OWNER_EMAIL=owner@example.com

# ------------------- optional provider accounts -------------------
# Google AI Studio: https://aistudio.google.com/apikey
# The current scaffold records these values but does not call Gemini yet.
GEMINI_API_KEY=

# Groq console: https://console.groq.com/keys
# The current scaffold records this value but does not call Groq yet.
GROQ_API_KEY=

# ------------------- optional notifications -------------------
# Telegram: message @BotFather, create a bot, then get the chat id from
# https://api.telegram.org/bot<BOT_TOKEN>/getUpdates after sending it a message.
# Telegram delivery is a planned adapter and is not active in dry-run mode.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Healthchecks.io: create a check at https://healthchecks.io/ and copy its ping URL.
# The heartbeat adapter is planned; leaving this empty is safe.
HEALTHCHECKS_HEARTBEAT_URL=

# ------------------- frontend -------------------
# Leave this commented for local development; Vite proxies /api to port 8000.
# VITE_API_BASE_URL=/api/v1
